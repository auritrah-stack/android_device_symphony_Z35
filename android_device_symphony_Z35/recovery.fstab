# Android fstab file for OrangeFox / TWRP (v2 / fs_mgr format)
#
#<dev>                                                    <mnt_point>   <type>   <mnt_flags and options>                                                                                                              <fs_mgr_flags>
# --- Dynamic (logical) partitions: mapped out of the "super" partition ---
system                                                     /system       ext4     ro                                                                                                                                   wait,logical,first_stage_mount
vendor                                                     /vendor       ext4     ro                                                                                                                                   wait,logical,first_stage_mount

# --- MTK metadata partition. It is called "md_udc" on MediaTek, not "metadata" ---
/dev/block/platform/bootdevice/by-name/md_udc               /metadata     ext4     noatime,nosuid,nodev,discard                                                                                                         wait,check,formattable,first_stage_mount

# --- Encrypted userdata (FBE v2 + metadata encryption, MTK Android 11) ---
/dev/block/platform/bootdevice/by-name/userdata             /data         ext4     noatime,nosuid,nodev,noauto_da_alloc,inlinecrypt                                                                                       latemount,wait,check,quota,reservedsize=128M,formattable,resize,fileencryption=aes-256-xts:aes-256-cts:v2,keydirectory=/metadata/vold/metadata_encryption,metadata_encryption=aes-256-xts:aes-256-cts:v2

/dev/block/platform/bootdevice/by-name/cache                /cache        ext4     noatime,nosuid,nodev,noauto_da_alloc                                                                                                 wait,check,formattable
/dev/block/platform/bootdevice/by-name/para                 /misc         emmc     defaults                                                                                                                             defaults
